# ---------------------------------------------------------------------------
# Peer Tutoring Platform - environment template
# Copy to `.env` for local development. NEVER commit the real `.env`.
# ---------------------------------------------------------------------------

# Data mode. Controls which persistence adapter the app uses.
#   amplify -> real AWS backend (Cognito + AppSync + DynamoDB). Requires
#              `amplify_outputs.json`, produced by `npx ampx sandbox` or by the
#              Amplify Hosting build. This is the production mode.
#   local   -> browser-local persistence for development and review without an
#              AWS account. The UI shows a permanent "Demo data" banner.
#   auto    -> use amplify when `amplify_outputs.json` is present, else local.
# Default when unset: auto
VITE_DATA_MODE=auto

# Optional public display name shown in the header/footer wordmark.
VITE_APP_NAME=PeerTutor

# ---------------------------------------------------------------------------
# NOTE: No AWS keys, secrets or database credentials belong in this file or in
# any VITE_* variable. Everything prefixed with VITE_ is embedded into the
# client bundle and is therefore public.
#
# Backend configuration (Cognito user pool, AppSync endpoint, region) is NOT
# set here. Amplify generates `amplify_outputs.json` at deploy time and that
# file is gitignored.
# ---------------------------------------------------------------------------
