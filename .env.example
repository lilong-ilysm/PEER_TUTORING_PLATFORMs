# ---------------------------------------------------------------------------
# PeerLearn - environment template
# Copy to `.env` for local development. NEVER commit the real `.env`.
# ---------------------------------------------------------------------------

# Data mode. Controls which persistence adapter the app uses.
#   rest    -> API Gateway + Lambda + DynamoDB + Cognito user pool.
#              THIS IS THE DEPLOYMENT TARGET FOR AWS ACADEMY LEARNER LAB.
#              Requires the three VITE_API_/VITE_COGNITO_ values below.
#   amplify -> Amplify Gen 2 (Cognito + AppSync + DynamoDB). Requires
#              `amplify_outputs.json`. NOT deployable in Learner Lab, because
#              Amplify Gen 2 needs iam:CreateRole.
#   local   -> browser-local persistence for development and review with no AWS
#              account. The UI shows a permanent "Demo data" banner.
#   auto    -> rest if configured, else amplify if amplify_outputs.json exists,
#              else local.
# Default when unset: auto
VITE_DATA_MODE=auto

# Optional public display name shown in the header/footer wordmark.
VITE_APP_NAME=PeerLearn

# ---------------------------------------------------------------------------
# REST backend (mode: rest)
#
# Copy these three values from the CloudFormation stack outputs after deploying
# infra/peerlearn.yaml:
#
#   aws cloudformation describe-stacks --stack-name peerlearn \
#     --region us-east-1 --query 'Stacks[0].Outputs'
#
# All three are PUBLIC identifiers, not secrets. A Cognito user pool id and app
# client id are designed to be shipped in a browser bundle. There is no identity
# pool, so the browser never receives AWS credentials.
# ---------------------------------------------------------------------------
VITE_API_BASE_URL=
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=

# ---------------------------------------------------------------------------
# NOTE: no AWS access key, secret, database credential or token belongs in this
# file. Everything prefixed with VITE_ is embedded into the client bundle and is
# therefore readable by anyone who loads the site.
# ---------------------------------------------------------------------------
