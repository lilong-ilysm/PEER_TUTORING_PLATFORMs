{
  "name": "peer-tutoring-platform",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Peer Tutoring Platform - connects students who need academic help with peers who can tutor them.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:ci": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "amplify:sandbox": "ampx sandbox",
    "amplify:generate": "ampx generate outputs",
    "build:lambda": "esbuild backend/handler.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist-lambda/index.js --external:@aws-sdk/*",
    "package:lambda": "npm run build:lambda && node scripts/package-lambda.mjs",
    "deploy:lambda": "node scripts/deploy-lambda.mjs",
    "deploy:frontend": "node scripts/deploy-frontend.mjs"
  },
  "dependencies": {
    "aws-amplify": "^6.6.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@aws-amplify/backend": "^1.7.0",
    "@aws-amplify/backend-cli": "^1.4.2",
    "@aws-sdk/client-dynamodb": "^3.699.0",
    "@aws-sdk/lib-dynamodb": "^3.699.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/aws-lambda": "^8.10.145",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "aws-cdk-lib": "^2.164.1",
    "constructs": "^10.4.2",
    "esbuild": "^0.24.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
